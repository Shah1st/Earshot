# Macro definitions for the rules in simulation/.gitattributes.
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# model files and demo data must be byte identical on every machine (no line ending conversion)
demo_pack/models/** -text
demo_pack/rides/** -text
demo_pack/clips/** -text
